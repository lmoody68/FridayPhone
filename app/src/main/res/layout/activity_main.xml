<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Friday Phone"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Hands-free call control, on the phone itself. Say &quot;Friday answer the call&quot; to pick up on speaker, &quot;Friday send to voicemail&quot; to decline an incoming call, or &quot;Friday disconnect the call&quot; to hang up DURING a call. (Friday must be set as the default assistant for mid-call hang-up to hear you.)"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/txtStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="○ Not listening"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Start listening" />

        <Button
            android:id="@+id/btnBattery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Keep Friday alive (battery)" />

        <Button
            android:id="@+id/btnA11y"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Enable Friday call control (accessibility)" />

        <Button
            android:id="@+id/btnAssistant"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Set Friday as default assistant (hear during calls)" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="— Diagnostics (fire the macro directly) —"
            android:textStyle="bold"
            android:gravity="center" />

        <Button
            android:id="@+id/btnTestAnswer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Test: Answer + Speaker" />

        <Button
            android:id="@+id/btnTestHangup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Test: Hang up" />

        <Button
            android:id="@+id/btnTestVoicemail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Test: Send to voicemail" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="— Mic Probe (run DURING a live call) —"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="Get on a call (speaker ON), tap Probe, then TALK out loud nonstop for ~15s. It tests every mic source and shows if Android feeds Friday your voice or silence."
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnProbe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="🔬 Probe mic (during a call)" />

        <TextView
            android:id="@+id/txtProbe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:padding="10dp"
            android:background="#111111"
            android:textColor="#00FF66"
            android:fontFamily="monospace"
            android:textSize="13sp"
            android:text="(probe results appear here)" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="How it works:\n• &quot;Friday answer the call&quot; → answers on speaker\n• &quot;Friday disconnect the call&quot; → hangs up DURING a call\n• &quot;Friday send to voicemail&quot; → declines an incoming call\n• &quot;Friday call Chris&quot; → dials that contact (then &quot;Friday stop&quot; within a few seconds to cancel)\n\nFriday acts on the phone itself — no MacroDroid. Answer / voicemail / dialing use the phone's Telecom system + your contacts (grant Phone + Contacts). Hang-up taps the dialer's own End button via Friday's Accessibility Service. Mid-call hang-up needs Friday set as the default assistant — that's what lets her hear you during a call."
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
